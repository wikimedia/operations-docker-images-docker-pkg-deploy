# Specialized makefile for building the deployment artifacts
# Global shell setting
SHELL = /bin/bash
# Global build dir
BUILD_DIR = $(CURDIR)/build
# Directory where the wheels are built
WHEELS_DIR = $(BUILD_DIR)/wheels
IMG_BASENAME := 'docker-registry.wikimedia.org/python3-build'

BULLSEYE_ARTIFACTS = $(WHEELS_DIR)/bullseye/artifacts.tar.gz
TRIXIE_ARTIFACTS = $(WHEELS_DIR)/trixie/artifacts.tar.gz

### Build-related tasks ###
# task all
# clean the build environment, and recreate the wheels.
all: clean bullseye diff-bullseye trixie diff-trixie

artifacts: bullseye trixie

bullseye: clean os-artifacts-bullseye
	cp $(BULLSEYE_ARTIFACTS) $(CURDIR)/artifacts/artifacts.bullseye.tar.gz

trixie: clean os-artifacts-trixie
	cp $(TRIXIE_ARTIFACTS) $(CURDIR)/artifacts/artifacts.trixie.tar.gz

os-artifacts-%:
	docker pull $(IMG_BASENAME)-$*:latest
	mkdir -p $(WHEELS_DIR)/$*
	docker run --rm -v $(CURDIR):/deploy:ro -v $(WHEELS_DIR)/$*:/wheels:rw -v /etc/group:/etc/group:ro \
		-v /etc/passwd:/etc/passwd:ro --user=$$(id -u) $(IMG_BASENAME)-$*:latest

# task diff
# Output the diff between the last and current revision of artifacts
diff-%:
	diff -u <(tar -tzf <(git show HEAD^:artifacts/artifacts.$*.tar.gz))  <(tar -tzf $(CURDIR)/artifacts/artifacts.$*.tar.gz) ||:

# task clean[-DISTRO]
# clean docker artifacts for one distro, or all artifacts
clean:
	- rm -rf $(WHEELS_DIR)

.PHONY: artifacts bullseye trixie all clean
